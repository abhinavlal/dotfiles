# ~/.config/ghostty/config
# Reload in place with cmd+shift+, — no restart needed.

# ── Font ──────────────────────────────────────────────────────────────────────
# Nerd Font variant: carries the glyphs the prompt draws (git branch, folder,
# language icons). Without it the prompt renders as tofu boxes.
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 14
font-thicken = true
font-feature = calt
font-feature = liga

# ── Theme ─────────────────────────────────────────────────────────────────────
# Follows macOS appearance automatically. Matches the prompt + fzf + bat colors.
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

background-opacity = 0.97
background-blur-radius = 20

# ── Window ────────────────────────────────────────────────────────────────────
window-padding-x = 14
window-padding-y = 10
window-padding-balance = true
window-decoration = true
window-theme = auto
macos-titlebar-style = tabs
macos-option-as-alt = true

# ── Cursor ────────────────────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = false
mouse-hide-while-typing = true

# ── Scrollback & selection ────────────────────────────────────────────────────
scrollback-limit = 10000000
copy-on-select = clipboard
confirm-close-surface = true

# ── Shell integration ─────────────────────────────────────────────────────────
# Enables cmd+↑/↓ jump-between-prompts, working-dir inheritance on new tabs/splits.
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ── Keybindings ───────────────────────────────────────────────────────────────
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+opt+left=goto_split:left
keybind = cmd+opt+right=goto_split:right
keybind = cmd+opt+up=goto_split:up
keybind = cmd+opt+down=goto_split:down
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+k=clear_screen
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1
